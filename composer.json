{
    "name": "fleetbase/solid-api",
    "version": "0.1.0",
    "description": "Solid Protocol Extension to Store and Share Data with Fleetbase",
    "keywords": [
        "fleetbase-extension",
        "solid",
        "solid-protocol",
        "decentralized",
        "decentralized-data",
        "fleetbase",
        "fleetbase-pod",
        "rdf",
        "linked-data",
        "ember-addon",
        "ember-engine"
    ],
    "license": "AGPL-3.0-or-later",
    "authors": [
        {
            "name": "Fleetbase Pte Ltd.",
            "email": "hello@fleetbase.io"
        },
        {
            "name": "Ronald A. Richardson",
            "email": "ron@fleetbase.io"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "ext-openssl": "*",
        "easyrdf/easyrdf": "^1.1",
        "firebase/php-jwt": "^6.10|^7.0",
        "fleetbase/core-api": "^2.0",
        "fleetbase/fleetops-api": "^0.7.0",
        "ml/json-ld": "^1.2"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.34.1",
        "nunomaduro/collision": "^8.0",
        "pestphp/pest": "^3.0",
        "phpstan/phpstan": "^2.0",
        "symfony/var-dumper": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "Fleetbase\\Solid\\": "server/src/",
            "Fleetbase\\Solid\\Seeders\\": "server/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Fleetbase\\Solid\\Tests\\": "server/tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "laravel": {
            "providers": [
                "Fleetbase\\Solid\\Providers\\SolidServiceProvider"
            ]
        },
        "fleetbase": {
            "sandbox-migrations": false
        }
    },
    "config": {
        "vendor-dir": "./server_vendor",
        "sort-packages": true,
        "preferred-install": "dist",
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "lint": "php-cs-fixer fix -v",
        "test:lint": "php-cs-fixer fix -v --dry-run",
        "test:types": "phpstan analyse --ansi --memory-limit=-1",
        "test:unit": "php scripts/pest-runner.php --colors=always server/tests",
        "test:coverage": "php scripts/coverage-runner.php --coverage --coverage-text --colors=always",
        "test:coverage:clover": "mkdir -p coverage && php scripts/coverage-runner.php --coverage-clover=coverage/clover.xml --colors=always",
        "coverage:summary": "php scripts/coverage-summary.php coverage/clover.xml",
        "coverage:baseline": [
            "@test:coverage:clover",
            "@coverage:summary"
        ],
        "test": [
            "@test:lint",
            "@test:types",
            "@test:unit"
        ]
    }
}
