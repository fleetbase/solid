<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.5/phpunit.xsd"
         bootstrap="./server_vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
>
    <testsuites>
        <testsuite name="default">
            <!-- Suffix "Test.php" rather than ".php" so that server/tests/Support,
                 which holds test doubles rather than tests, is not collected. -->
            <directory suffix="Test.php">./server/tests</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory suffix=".php">./server/src</directory>
        </include>
    </source>
</phpunit>
